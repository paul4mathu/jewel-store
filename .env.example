# Supabase: Connect > Transaction pooler (port 6543). Neon or any Postgres URL also works.
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# Optional. Defaults to the Vercel production URL, or localhost in dev.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
